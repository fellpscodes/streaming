# Etapa 3 (metadados). Nunca commitar o .env.local real.
TMDB_API_KEY=
# Alternativa à chave: token de leitura (Bearer). Se definido, tem prioridade.
TMDB_READ_TOKEN=
# Opcional: caminho do banco SQLite (padrão: ./data/streaming.db)
# DATABASE_PATH=
# Etapa 5 (player). Onde ficam os vídeos remuxados/legendas extraídas e o limite do cache de vídeo.
# CACHE_DIR=./data/cache
# STREAM_CACHE_GB=30
